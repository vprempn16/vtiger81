SELECT vtiger_project.projectname, vtiger_project.linktoaccountscontacts, vtiger_project.startdate, vtiger_project.targetenddate, vtiger_project.actualenddate, vtiger_project.targetbudget, vtiger_project.progress, vtiger_project.projectstatus, vtiger_crmentity.smownerid, vtiger_project.projectid, vtiger_crmentity_user_field.starred FROM vtiger_project INNER JOIN vtiger_crmentity ON vtiger_project.projectid = vtiger_crmentity.crmid LEFT JOIN vtiger_users ON vtiger_crmentity.smownerid = vtiger_users.id LEFT JOIN vtiger_groups ON vtiger_crmentity.smownerid = vtiger_groups.groupid LEFT JOIN vtiger_crmentity_user_field ON vtiger_project.projectid = vtiger_crmentity_user_field.recordid AND vtiger_crmentity_user_field.userid=13 INNER JOIN vt_tmp_u13 vt_tmp_u13 ON ( vt_tmp_u13.id = vtiger_crmentity.smownerid OR vt_tmp_u13.id = vtiger_crmentity.smcreatorid) AND vtiger_crmentity.smownerid IN (SELECT user_id FROM vtiger_user_branch_map WHERE partner_id = 0 AND status = 1) AND (vtiger_crmentity.smcreatorid IN (13,14) OR vtiger_crmentity.smownerid IN (13,14)) WHERE vtiger_crmentity.deleted=0 AND vtiger_project.projectid > 0 AND (vtiger_crmentity.smcreatorid IN (13,14) OR vtiger_crmentity.smownerid IN (13,14)) ORDER BY vtiger_crmentity.modifiedtime DESC LIMIT 0, 21  